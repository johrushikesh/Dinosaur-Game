{
  "appId": "com.rexrun.game",
  "appName": "Rex Run",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#1a0a00",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release.keystore",
      "keystorePassword": "rex-run-2024",
      "keystoreAlias": "rexrun",
      "keystoreAliasPassword": "rex-run-2024",
      "releaseType": "APK"
    }
  },
  "ios": {
    "contentInset": "always"
  }
}
